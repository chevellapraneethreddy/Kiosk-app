# Server Port & URLs
PORT=5000
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Database Connection (SQLite)
DATABASE_URL=file:./dev.db

# AI Provider Configuration
# Options: decart
AI_PROVIDER=decart

# Decart AI Provider Details (Lucy Virtual Try-On 3.5)
DECART_API_KEY=dct_kis_your_actual_decart_api_key_here
AI_MODEL=lucy-vton-3.5

# Storage Provider Configuration
# Options: local | s3 | r2 | supabase
STORAGE_PROVIDER=local

# Security & Expiration
ADMIN_EMAIL=admin@standee.com
ADMIN_PASSWORD_HASH=$2b$10$EpRnTzVlqHNP0.fKbXWkDeZtB2t02Tj/l8n0j4mS5v8H/r1P2Q4i2 # default: "admin123"
JWT_SECRET=super-secret-standee-jwt-key-2026
QR_EXPIRATION_MINUTES=60
DEFAULT_CLEANUP_HOURS=24
MAX_UPLOAD_MB=15

# Kiosk Settings
KIOSK_MODE=true
RESULT_TIMEOUT_SECONDS=60
INACTIVITY_TIMEOUT_SECONDS=120
