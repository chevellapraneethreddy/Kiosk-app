# =======================================================
# Vercel Frontend Environment Configuration
# Set this in your Vercel Dashboard: Project Settings -> Environment Variables
# =======================================================

# Public Render Backend URL (Where frontend sends API requests, SSE, and fetches images)
# Format: https://YOUR-RENDER-BACKEND.onrender.com (NO trailing slash, NO localhost)
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
