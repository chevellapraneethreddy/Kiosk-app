# =======================================================
# Render Backend Environment Configuration
# Set these in your Render Dashboard: Dashboard -> Environment
# =======================================================

# Server Port (Render sets this automatically, default 5000)
PORT=5000
NODE_ENV=production

# PUBLIC FRONTEND URL (CRITICAL FOR QR CODES)
# This is encoded in all Mobile Upload and Result QR codes.
# Must be your public Vercel production HTTPS URL.
# Example: https://kiosk-app.vercel.app
PUBLIC_BASE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# FRONTEND CORS ORIGIN
# Allows your Vercel frontend to make API calls to Render.
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# AI Provider Configuration (Decart Lucy Virtual Try-On 3.5)
# Backend-only secret. NEVER expose to frontend.
AI_PROVIDER=decart
DECART_API_KEY=dct_kis_your_decart_api_key_here
AI_MODEL=lucy-vton-3.5

# Database URL (SQLite or managed PostgreSQL)
DATABASE_URL=file:./dev.db

# Storage Provider & Timeouts
STORAGE_PROVIDER=local
JWT_SECRET=production-secure-random-jwt-secret-change-me
QR_EXPIRATION_MINUTES=60
DEFAULT_CLEANUP_HOURS=24
MAX_UPLOAD_MB=15
KIOSK_MODE=true
